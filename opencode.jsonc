{
  "$schema": "https://opencode.ai/config.json",
  "model": "morph/morph-kimik31",
  "default_agent": "orchestrator",
  "agents": {
    "build": {
      "model": "morph/morph-dsv41flash"
    },
    "explore": {
      "model": "morph/morph-dsv41flash"
    },
    "general": {
      "model": "morph/morph-dsv41flash"
    },
    "compaction": {
      "model": "morph/morph-dsv41flash"
    },
    "title": {
      "model": "morph/morph-dsv41flash"
    },
    "summary": {
      "model": "morph/morph-dsv41flash"
    }
  },
  "mcp": {
    "composio": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://connect.composio.dev/mcp"],
    "paper": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.paper.design"]
    }
  }
}
