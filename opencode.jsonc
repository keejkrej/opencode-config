{
  "$schema": "https://opencode.ai/config.json",
  "model": "vercel/moonshotai/kimi-k3.1-pro",
  "default_agent": "build",
  "agents": {
    "explore": {
      "model": "vercel/deepseek/deepseek-v4.1-flash-1017"
    },
    "general": {
      "model": "vercel/deepseek/deepseek-v4.1-flash-1017"
    },
    "compaction": {
      "model": "vercel/deepseek/deepseek-v4.1-flash-1017"
    },
    "title": {
      "model": "vercel/deepseek/deepseek-v4.1-flash-1017"
    },
    "summary": {
      "model": "vercel/deepseek/deepseek-v4.1-flash-1017"
    }
  },
  "mcp": {
    "servers": {
      "paper": {
        "type": "local",
        "command": ["paper", "mcp"]
      },
      "ambient": {
        "type": "remote",
        "url": "http://127.0.0.1:8765/mcp",
        "oauth": false
      },
      "mobbin": {
        "type": "local",
        "command": ["npx", "-y", "mcp-remote", "https://api.mobbin.com/mcp"]
      },
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"],
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
